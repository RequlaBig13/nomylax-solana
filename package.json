    "@solana/react": "8.3.0",
    "@solana-program/system": "0.14.1",
    "next": "16.3.8",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "zod": "4.6.5",
    "@solana-program/memo": "0.15.0",
    "postgres": "^3.4.7"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.5",
    "@tailwindcss/postcss": "^4.0.0",
    "@types/node": "^22.10.0",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitest/coverage-v8": "^4.1.11",
    "eslint": "^9.39.5",
    "tailwindcss": "^4.0.0",
