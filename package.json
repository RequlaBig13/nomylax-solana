{
  "name": "nomylax-solana",
  "version": "1.0.0",
  "private": true,
  "description": "Nomylax - financial firewall for autonomous AI agents on Solana",
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint .",
