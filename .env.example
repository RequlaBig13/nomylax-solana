# Public application identity
NEXT_PUBLIC_APP_URL=http://localhost:3000
NEXT_PUBLIC_SOLANA_NETWORK=devnet
NEXT_PUBLIC_SOLANA_RPC_URL=https://api.devnet.solana.com

# Optional: set after the Nomylax Guard Anchor program is deployed.
NEXT_PUBLIC_NOMYLAX_GUARD_PROGRAM_ID=

# Server-only session signing. Use a long random value in production.
SESSION_SECRET=

# Control Copilot: explanation only. Never expose this as NEXT_PUBLIC_*.
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-4-20250514

# Registered HTTP agent integration
AGENT_API_KEY=
AGENT_ENDPOINT_ALLOWLIST=

# Optional production persistence. The contest MVP still runs locally without it.
DATABASE_URL=
